# vcstool manifest - upstream Unity sources (Layer A).
#
# Run:  vcs import . < manifest.repos
# The packages/ directory is gitignored in this meta-repository; each entry is
# an independent repository with its own history.
#
# Verified against the gitlab.com/ubuntu-unity group on 2026-09-22 (28 projects
# across three subgroups: unity, lomiri, website).
#
# NOT in the upstream group, despite being core Unity 7 components:
#   compiz, bamf, unity-gtk-module, indicator-*, vala-appmenu-panel
# These live in the Ubuntu archive only and are imported with git-ubuntu -
# see docs/ARCHITECTURE.md.

repositories:
  # Our changes on unity/resolute; upstream (gitlab ubuntu-unity, branch
  # ubuntu/devel) is mirrored as ubuntu/devel here - add it as a remote to
  # prepare merge requests.
  packages/unity:
    type: git
    url: https://github.com/Ubuntu-Unity-LifeSupport/unity.git
    version: unity/resolute
  packages/nux:
    type: git
    url: https://gitlab.com/ubuntu-unity/unity/nux.git
    version: ubuntu/devel
  packages/unity-session:
    type: git
    url: https://github.com/Ubuntu-Unity-LifeSupport/unity-session.git
    version: unity/resolute
  packages/unity-settings-daemon:
    type: git
    url: https://github.com/Ubuntu-Unity-LifeSupport/unity-settings-daemon.git
    version: unity/resolute
  packages/unity-control-center:
    type: git
    url: https://gitlab.com/ubuntu-unity/unity/unity-control-center.git
    version: ubuntu/devel
  packages/unity-greeter:
    type: git
    url: https://gitlab.com/ubuntu-unity/unity/unity-greeter.git
    version: ubuntu/devel
  packages/unity-indicators:
    type: git
    url: https://gitlab.com/ubuntu-unity/unity/unity-indicators.git
    version: main
  packages/unity-scope-home:
    type: git
    url: https://gitlab.com/ubuntu-unity/unity/unity-scope-home.git
    version: ubuntu/devel

  # Our own repositories. Patched Ubuntu packages follow the gbp layout in
  # section 5 of the handoff: unity/resolute, upstream/latest, pristine-tar.
  packages/compiz:
    type: git
    url: https://github.com/Ubuntu-Unity-LifeSupport/compiz.git
    version: unity/resolute
  packages/lightdm:
    type: git
    url: https://github.com/Ubuntu-Unity-LifeSupport/lightdm.git
    version: unity/resolute
  packages/gtk-nocsd:
    type: git
    url: https://github.com/Ubuntu-Unity-LifeSupport/gtk-nocsd.git
    version: unity/resolute
  packages/cinnamon-session:
    type: git
    url: https://github.com/Ubuntu-Unity-LifeSupport/cinnamon-session.git
    version: unity/resolute
  packages/light-locker:
    type: git
    url: https://github.com/Ubuntu-Unity-LifeSupport/light-locker.git
    version: unity/resolute
  packages/unity-gtk4-menu:
    type: git
    url: https://github.com/Ubuntu-Unity-LifeSupport/unity-gtk4-menu.git
    version: main
  # Not in the upstream group: Ubuntu's Calamares settings (Lubuntu, Kubuntu,
  # Ubuntu Unity). Our change is on a local unity/resolute branch; patch in
  # docs/research/calamares-oem/.
  packages/calamares-settings-ubuntu:
    type: git
    url: https://git.launchpad.net/~ubuntu-qt-code/+git/calamares-settings-ubuntu
    version: ubuntu/resolute
  # git-ubuntu imports; our changes on local unity/resolute branches, patches
  # in docs/research/indicator-units/.
  packages/indicator-bluetooth:
    type: git
    url: https://git.launchpad.net/ubuntu/+source/indicator-bluetooth
    version: ubuntu/resolute
  packages/indicator-printers:
    type: git
    url: https://git.launchpad.net/ubuntu/+source/indicator-printers
    version: ubuntu/resolute
  packages/appmenu-gtk-module:
    type: git
    url: https://git.launchpad.net/ubuntu/+source/appmenu-gtk-module
    version: ubuntu/resolute
  packages/indicator-datetime:
    type: git
    url: https://git.launchpad.net/ubuntu/+source/indicator-datetime
    version: ubuntu/resolute
  packages/indicator-power:
    type: git
    url: https://git.launchpad.net/ubuntu/+source/indicator-power
    version: ubuntu/resolute
  packages/indicator-session:
    type: git
    url: https://git.launchpad.net/ubuntu/+source/indicator-session
    version: ubuntu/resolute
  packages/indicator-sound:
    type: git
    url: https://git.launchpad.net/ubuntu/+source/indicator-sound
    version: ubuntu/resolute
  packages/indicator-keyboard:
    type: git
    url: https://git.launchpad.net/ubuntu/+source/indicator-keyboard
    version: ubuntu/resolute
