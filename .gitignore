# Package sources are independent repositories, imported with vcstool.
/packages/
# Build artefacts and local aptly state.
/build/out/
/repo/.aptly/
*.deb
*.ddeb
*.buildinfo
# UNITY-20261008-003: a build directory's .buildinfo is committed with its
# manifest (docs/research/<task>/<build dir>/), for tested_build and published_by.
!docs/research/*/*/*.buildinfo
*.changes
*.build
# Source package files copied next to build manifests (build_sbuild.py); large,
# identified by their hashes in the manifest, kept out of git like the .debs.
docs/research/*/build/*.tar.*
docs/research/*/build/*.diff.gz
