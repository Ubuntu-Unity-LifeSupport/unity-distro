      "Bash(xwd)",
      "Bash(xwd *)",
      "Edit(//etc/sudoers)",
      "Edit(//etc/sudoers.d/**)",
      "Read(//home/claude/.gnupg/private-keys-v1.d/**)",
      "Read(//home/claude/.claude/.credentials.json)"
    ],
