From ad9d0bf3ab289e6ed829f97900be585b8fad5f4d Mon Sep 17 00:00:00 2001
From: NeiroNext <mihail.rozshko@gmail.com>
Date: Fri, 25 Sep 2026 01:40:59 +0000
Subject: [PATCH 1/4] Build-depend on lightdm-vala and systemd-dev

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 debian/changelog | 10 ++++++++++
 debian/control   |  3 ++-
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/debian/changelog b/debian/changelog
index 17d6a01..87e41d9 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,13 @@
+indicator-keyboard (0.0.0+19.10.20240924-0ubuntu1+unity1) resolute; urgency=medium
+
+  * Build-depend on lightdm-vala, split off from liblightdm-gobject-1-dev
+    (from 0ubuntu3 in 26.10).
+  * Build-depend on systemd-dev instead of systemd, so configure finds
+    systemduserunitdir and the systemd user unit is still installed (26.10's
+    rebuild lost it).
+
+ -- Ubuntu Unity Life Support <mihail.rozshko@gmail.com>  Fri, 25 Sep 2026 01:40:00 +0000
+
 indicator-keyboard (0.0.0+19.10.20240924-0ubuntu1) oracular; urgency=medium
 
   [ Sebastian Geiger ]
diff --git a/debian/control b/debian/control
index 71a0925..5d17f8c 100644
--- a/debian/control
+++ b/debian/control
@@ -16,10 +16,11 @@ Build-Depends: debhelper-compat (= 13),
                libgtk-3-dev,
                libibus-1.0-dev (>= 1.5.0),
                liblightdm-gobject-1-dev,
+               lightdm-vala,
                valac,
                xauth,
                xvfb,
-               systemd,
+               systemd-dev,
 Standards-Version: 3.9.4
 Homepage: https://code.launchpad.net/indicator-keyboard
 # If you aren't a member of ~indicator-applet-developers but need to upload
-- 
