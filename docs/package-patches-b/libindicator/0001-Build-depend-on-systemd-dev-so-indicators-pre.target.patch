From f75a61760288cde9878f86c68f963f09a9808fc7 Mon Sep 17 00:00:00 2001
From: NeiroNext <mihail.rozshko@gmail.com>
Date: Fri, 25 Sep 2026 16:55:40 +0000
Subject: [PATCH] Build-depend on systemd-dev, so indicators-pre.target is
 installed again

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 debian/changelog | 11 +++++++++++
 debian/control   |  3 ++-
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/debian/changelog b/debian/changelog
index 15e0802..72168f5 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,14 @@
+libindicator (16.10.0+18.04.20180321.1-0ubuntu8+unity1) resolute; urgency=medium
+
+  * Build-depend on systemd-dev. configure.ac asks systemd.pc for the user
+    unit directory; systemd.pc moved to systemd-dev, which nothing pulls in
+    any more, so in 26.04 indicators-pre.target is not installed and
+    dh_install --fail-missing stops the build. The archive's binaries
+    predate the move (last built for noble). unity-panel-service has
+    BindsTo=indicators-pre.target, so the target must keep shipping.
+
+ -- Ubuntu Unity Life Support <mihail.rozshko@gmail.com>  Fri, 25 Sep 2026 16:55:33 +0000
+
 libindicator (16.10.0+18.04.20180321.1-0ubuntu8) noble; urgency=medium
 
   * No-change rebuild for CVE-2024-3094
diff --git a/debian/control b/debian/control
index a1667ae..af0c7f5 100644
--- a/debian/control
+++ b/debian/control
@@ -15,7 +15,8 @@ Build-Depends: debhelper (>= 9),
                libglib2.0-dev (>= 2.37),
                libgtk2.0-dev (>= 2.18),
                libgtk-3-dev (>= 2.91.3),
-               libido3-0.1-dev (>= 13.10.0)
+               libido3-0.1-dev (>= 13.10.0),
+               systemd-dev
 Standards-Version: 3.9.2
 Homepage: https://launchpad.net/libindicator
 # If you aren't a member of ~indicator-applet-developers but need to upload
-- 
2.53.0

