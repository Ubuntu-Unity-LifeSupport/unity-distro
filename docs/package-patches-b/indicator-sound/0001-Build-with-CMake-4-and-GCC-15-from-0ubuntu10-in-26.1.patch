From 338d8fdd2f69360203b9df6d7f4ba11ff53002ac Mon Sep 17 00:00:00 2001
From: NeiroNext <mihail.rozshko@gmail.com>
Date: Fri, 25 Sep 2026 01:40:59 +0000
Subject: [PATCH] Build with CMake 4 and GCC 15 (from 0ubuntu10 in 26.10)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt   | 2 +-
 debian/changelog | 7 +++++++
 src/main.c       | 8 +++++---
 3 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9f27ec0..19691cd 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,5 +1,5 @@
 project(indicator-sound C CXX)
-cmake_minimum_required(VERSION 2.8.9)
+cmake_minimum_required(VERSION 3.10)
 
 set(CMAKE_MODULE_PATH "${CMAKE_SOURCE_DIR}/cmake" "${CMAKE_MODULE_PATH}")
 
diff --git a/debian/changelog b/debian/changelog
index eea98ab..23c615f 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,10 @@
+indicator-sound (12.10.2+18.10.20180612-0ubuntu7+unity1) resolute; urgency=medium
+
+  * Fix build with CMake 4 and GCC 15, from 0ubuntu10 in 26.10
+    (LP: #2166355).
+
+ -- Ubuntu Unity Life Support <mihail.rozshko@gmail.com>  Fri, 25 Sep 2026 01:40:00 +0000
+
 indicator-sound (12.10.2+18.10.20180612-0ubuntu7) noble; urgency=medium
 
   * Disable tests as gtest no longer supports C++11.
diff --git a/src/main.c b/src/main.c
index 43e330d..a324dd6 100644
--- a/src/main.c
+++ b/src/main.c
@@ -15,6 +15,8 @@
  */
 
 #include <glib.h>
+#include <glib/gi18n.h>
+#include <glib-unix.h>
 #include <locale.h>
 #include <libnotify/notify.h>
 
@@ -62,12 +64,12 @@ on_bus_acquired(GDBusConnection *connection,
     }
 
     pgloop = pa_glib_mainloop_new(NULL);
-    options = indicator_sound_options_gsettings_new();
+    options = INDICATOR_SOUND_OPTIONS (indicator_sound_options_gsettings_new ());
     accounts_service_access = accounts_service_access_new();
     volume = volume_control_pulse_new(options, pgloop, accounts_service_access);
-    warning = volume_warning_pulse_new(options, pgloop);
+    warning = VOLUME_WARNING (volume_warning_pulse_new (options, pgloop));
 
-    service = indicator_sound_service_new (playerlist, volume, accounts, options, warning, accounts_service_access);
+    service = indicator_sound_service_new (playerlist, VOLUME_CONTROL (volume), accounts, options, warning, accounts_service_access);
 
     g_clear_object(&playerlist);
     g_clear_object(&options);
-- 
2.53.0

