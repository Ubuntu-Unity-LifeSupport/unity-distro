---
 CMakeLists.txt   | 2 +-
 debian/changelog | 7 +++++++
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9936a44..d9c9797 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,5 +1,5 @@
 project (indicator-session C CXX)
-cmake_minimum_required (VERSION 2.8.9)
+cmake_minimum_required(VERSION 3.10)
 
 set (PROJECT_VERSION "13.10.1")
 set (PACKAGE ${CMAKE_PROJECT_NAME})
diff --git a/debian/changelog b/debian/changelog
index d19c3f0..28fea49 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,10 @@
+indicator-session (17.3.20+21.10.20210613.1-0ubuntu5+unity1) resolute; urgency=medium
+
+  * Build with CMake 4: require CMake 3.10 in CMakeLists.txt (3.5 is the
+    oldest CMake 4 accepts).
+
+ -- Ubuntu Unity Life Support <mihail.rozshko@gmail.com>  Fri, 25 Sep 2026 01:40:00 +0000
+
 indicator-session (17.3.20+21.10.20210613.1-0ubuntu5) resolute; urgency=medium
 
   * No-change mass rebuild for Ubuntu 26.04 (LP: #2132257)
