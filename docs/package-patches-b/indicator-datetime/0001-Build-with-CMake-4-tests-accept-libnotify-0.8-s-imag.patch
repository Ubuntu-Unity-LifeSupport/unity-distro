From 7676fbe0948908fdaba5dd54a4d55575bda23b8e Mon Sep 17 00:00:00 2001
From: NeiroNext <mihail.rozshko@gmail.com>
Date: Fri, 25 Sep 2026 01:40:59 +0000
Subject: [PATCH 1/2] Build with CMake 4; tests accept libnotify 0.8's
 image-path icon

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt              |  2 +-
 cmake/GdbusCodegen.cmake    |  2 +-
 debian/changelog            |  9 +++++++++
 tests/test-notification.cpp | 11 ++++++++++-
 tests/test-sound.cpp        | 11 ++++++++++-
 5 files changed, 31 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 762f482..d15372e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,5 +1,5 @@
 project (indicator-datetime C CXX)
-cmake_minimum_required (VERSION 2.8.9)
+cmake_minimum_required(VERSION 3.10)
 
 list (APPEND CMAKE_MODULE_PATH ${CMAKE_SOURCE_DIR}/cmake)
 
diff --git a/cmake/GdbusCodegen.cmake b/cmake/GdbusCodegen.cmake
index ddb2995..14e3f46 100644
--- a/cmake/GdbusCodegen.cmake
+++ b/cmake/GdbusCodegen.cmake
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 2.6)
+cmake_minimum_required(VERSION 3.10)
 if(POLICY CMP0011)
   cmake_policy(SET CMP0011 NEW)
 endif(POLICY CMP0011)
diff --git a/debian/changelog b/debian/changelog
index c4a4d38..3252176 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,12 @@
+indicator-datetime (15.10+21.04.20210304-0ubuntu6+unity1) resolute; urgency=medium
+
+  * Build with CMake 4: require CMake 3.10 in CMakeLists.txt and
+    cmake/GdbusCodegen.cmake (3.5 is the oldest CMake 4 accepts).
+  * tests: accept the icon name as the image-path hint. libnotify 0.8 sends
+    it there and leaves app_icon empty, so two tests failed the build.
+
+ -- Ubuntu Unity Life Support <mihail.rozshko@gmail.com>  Fri, 25 Sep 2026 01:40:00 +0000
+
 indicator-datetime (15.10+21.04.20210304-0ubuntu6) noble; urgency=medium
 
   * No-change rebuild for CVE-2024-3094
diff --git a/tests/test-notification.cpp b/tests/test-notification.cpp
index ccece39..8d1277a 100644
--- a/tests/test-notification.cpp
+++ b/tests/test-notification.cpp
@@ -176,9 +176,18 @@ TEST_F(NotificationFixture,Notification)
         g_variant_get_child(notify_calls[0].params, 0, "&s", &app_name);
         ASSERT_STREQ(APP_NAME, app_name);
 
-        // test that Notify was called with the type-appropriate icon
+        // test that Notify was called with the type-appropriate icon.
+        // libnotify >= 0.8 sends it as the image-path hint and leaves
+        // app_icon empty; older versions sent it as app_icon.
         const gchar* icon_name {nullptr};
         g_variant_get_child(notify_calls[0].params, 2, "&s", &icon_name);
+        if (!g_strcmp0(icon_name, ""))
+        {
+            auto icon_hints = g_variant_get_child_value(notify_calls[0].params, 6);
+            if (!g_variant_lookup(icon_hints, "image-path", "&s", &icon_name))
+                g_variant_lookup(icon_hints, "image_path", "&s", &icon_name);
+            g_variant_unref(icon_hints);
+        }
         ASSERT_STREQ(test_appt.icon_name, icon_name);
 
         // test that the Notification title has the correct prefix
diff --git a/tests/test-sound.cpp b/tests/test-sound.cpp
index 6c717f2..2103c49 100644
--- a/tests/test-sound.cpp
+++ b/tests/test-sound.cpp
@@ -89,8 +89,17 @@ TEST_F(NotificationFixture, InteractiveDuration)
   g_variant_get_child (params, 0, "&s", &str);
   ASSERT_STREQ(APP_NAME, str);
 
-  // confirm that the icon passed to Notify was "alarm-clock"
+  // confirm that the icon passed to Notify was "calendar-app". libnotify
+  // >= 0.8 sends the icon name as the image-path hint and leaves app_icon
+  // empty; older versions sent it as app_icon.
   g_variant_get_child (params, 2, "&s", &str);
+  if (!g_strcmp0 (str, ""))
+  {
+    auto icon_hints = g_variant_get_child_value (params, 6);
+    if (!g_variant_lookup (icon_hints, "image-path", "&s", &str))
+      g_variant_lookup (icon_hints, "image_path", "&s", &str);
+    g_variant_unref (icon_hints);
+  }
   ASSERT_STREQ("calendar-app", str);
 
   // confirm that the hints passed to Notify included a timeout matching duration_minutes
-- 
2.53.0

