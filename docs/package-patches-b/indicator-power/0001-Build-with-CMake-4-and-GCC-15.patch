From bff6e5d7a49c94d1803851b6edf51a84902bbe4b Mon Sep 17 00:00:00 2001
From: NeiroNext <mihail.rozshko@gmail.com>
Date: Fri, 25 Sep 2026 01:40:59 +0000
Subject: [PATCH] Build with CMake 4 and GCC 15

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt           | 2 +-
 cmake/GdbusCodegen.cmake | 2 +-
 debian/changelog         | 9 +++++++++
 src/service.c            | 2 +-
 4 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 631c483..5f34910 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,5 +1,5 @@
 project(indicator-power C CXX)
-cmake_minimum_required(VERSION 2.8.9)
+cmake_minimum_required(VERSION 3.10)
 
 list(APPEND CMAKE_MODULE_PATH ${CMAKE_SOURCE_DIR}/cmake)
 
diff --git a/cmake/GdbusCodegen.cmake b/cmake/GdbusCodegen.cmake
index ddb2995..14e3f46 100644
--- a/cmake/GdbusCodegen.cmake
+++ b/cmake/GdbusCodegen.cmake
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 2.6)
+cmake_minimum_required(VERSION 3.10)
 if(POLICY CMP0011)
   cmake_policy(SET CMP0011 NEW)
 endif(POLICY CMP0011)
diff --git a/debian/changelog b/debian/changelog
index 1fc7d81..2858aac 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,12 @@
+indicator-power (12.10.6+17.10.20170829.1-0ubuntu9+unity1) resolute; urgency=medium
+
+  * Build with CMake 4: require CMake 3.10 in CMakeLists.txt and
+    cmake/GdbusCodegen.cmake (3.5 is the oldest CMake 4 accepts).
+  * src/service.c: cast the bus connection, an error with GCC 15
+    (-Wincompatible-pointer-types).
+
+ -- Ubuntu Unity Life Support <mihail.rozshko@gmail.com>  Fri, 25 Sep 2026 01:40:00 +0000
+
 indicator-power (12.10.6+17.10.20170829.1-0ubuntu9) noble; urgency=medium
 
   * Disable test suite, googletest requires at least C++14 but indicator-power
diff --git a/src/service.c b/src/service.c
index eca803d..d65c9f0 100644
--- a/src/service.c
+++ b/src/service.c
@@ -967,7 +967,7 @@ on_bus_acquired (GDBusConnection * connection,
 
   g_debug ("bus acquired: %s", name);
 
-  p->conn = g_object_ref (G_OBJECT (connection));
+  p->conn = G_DBUS_CONNECTION (g_object_ref (G_OBJECT (connection)));
   g_object_notify_by_pspec (G_OBJECT(self), properties[PROP_BUS]);
 
   /* export the battery properties */
-- 
2.53.0

