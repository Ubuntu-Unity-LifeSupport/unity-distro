diff -Nru session-migration-0.3.9build2/CMakeLists.txt session-migration-0.3.9build2+unity1/CMakeLists.txt
--- session-migration-0.3.9build2/CMakeLists.txt	2024-03-24 22:29:32.000000000 +0000
+++ session-migration-0.3.9build2+unity1/CMakeLists.txt	2026-09-26 15:16:52.000000000 +0000
@@ -1,4 +1,4 @@
-cmake_minimum_required (VERSION 2.8) 
+cmake_minimum_required(VERSION 3.10) 
 project(user-migration)
 
 find_package (PkgConfig)
diff -Nru session-migration-0.3.9build2/debian/changelog session-migration-0.3.9build2+unity1/debian/changelog
--- session-migration-0.3.9build2/debian/changelog	2025-12-01 14:14:13.000000000 +0000
+++ session-migration-0.3.9build2+unity1/debian/changelog	2026-09-26 15:17:03.000000000 +0000
@@ -1,3 +1,13 @@
+session-migration (0.3.9build2+unity1) resolute; urgency=medium
+
+  * CMakeLists.txt: require CMake 3.10. CMake 4 removed compatibility with
+    versions before 3.5, so the package no longer configured in resolute.
+  * tests/migration_tests.py: escape the script paths in the expected-output
+    regex. A build directory with a '+' in its name (any +unityN version)
+    made the pattern not match.
+
+ -- Ubuntu Unity Life Support <mihail.rozshko@gmail.com>  Sat, 26 Sep 2026 15:17:03 +0000
+
 session-migration (0.3.9build2) resolute; urgency=medium
 
   * No-change mass rebuild for Ubuntu 26.04 (LP: #2132257)
diff -Nru session-migration-0.3.9build2/tests/migration_tests.py session-migration-0.3.9build2+unity1/tests/migration_tests.py
--- session-migration-0.3.9build2/tests/migration_tests.py	2024-03-24 22:29:32.000000000 +0000
+++ session-migration-0.3.9build2+unity1/tests/migration_tests.py	2026-09-26 15:17:03.000000000 +0000
@@ -204,8 +204,8 @@
 
         # check the debug output
         self.assertTrue(re.match("Using '{}' directory\nFile '{files}_test.sh already migrated, skipping\nFile '{files}_test.sh already migrated, skipping\n"
-                                 "File '{files}_test.sh already migrated, skipping\nExecuting: {}\nExecuting: {}\n".format(self.script_path, os.path.join(self.script_path, '08_test.sh'),
-                                                                                                                      os.path.join(self.script_path, '08_testexecute.sh'),
+                                 "File '{files}_test.sh already migrated, skipping\nExecuting: {}\nExecuting: {}\n".format(re.escape(self.script_path), re.escape(os.path.join(self.script_path, '08_test.sh')),
+                                                                                                                      re.escape(os.path.join(self.script_path, '08_testexecute.sh')),
                                                                                                                       files='(01|02|10)'),
                         stdout))
         self.assertEqual(stderr, 'Failed to execute child process “{}” (Permission denied)\nstdout: (null)\nstderr: (null)\n'.format(os.path.join(self.script_path, '08_test.sh')))
