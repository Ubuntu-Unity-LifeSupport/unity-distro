+// Global menu: where the shell shows the menubar, the main menu of a GTK4
+// header bar is set as the application's menubar, which GTK exports for the
+// global menu. GTK_NOCSD_NO_GLOBAL_MENU=1 disables it.
+
+// A menu found in a window, and how likely it is to be the main menu
+struct GTKNoCSDMenuCandidate {
+	GtkWidget *Owner;
+	GMenuModel *Model;
+	bool Shown;
+	bool Primary;
+	int Score;
+};
+
+// Every menu found in a window
+struct GTKNoCSDMenuCandidates {
+	struct GTKNoCSDMenuCandidate List[32];
+	size_t Count;
+};
+
+// A class action made reachable over D-Bus, activated from its menu's owner
+struct GTKNoCSDMenuProxy {
+	GtkWidget *Owner;
+	GtkWidget *Holder;
+	gchar *Name;
+};
+
+// Whether windows were hooked, and whether every function was found
+bool GTKNoCSDMenuHooked = false, GTKNoCSDMenuReady = false,
+	GTKNoCSDMenuWatching = false;
+
+// The menubar set by the library, to tell it apart from the application's
+GMenuModel *GTKNoCSDMenubar = NULL;
+
+// The original realize of GtkWindow and GtkApplicationWindow
+void (*GTKNoCSDWindowRealize)(GtkWidget *) = NULL;
+void (*GTKNoCSDApplicationWindowRealize)(GtkWidget *) = NULL;
+
+bool GTKNoCSDMenuShown(GtkWidget *Widget) {
+	// Whether the widget is visible and no container keeps it hidden. At
+	// realize nothing is mapped yet, so a hidden stack page is also visible,
+	// but its container clears child-visible on it or on an ancestor
+
+	if (!o_gtk_widget_is_visible(Widget)) {
+		return false;
+	}
+
+	// WARNING: Own call
+	for (GtkWidget *Current = Widget; Current != NULL;
+		Current = gtk_widget_get_parent(Current)) {
+		if (!o_gtk_widget_get_child_visible(Current)) {
+			return false;
+		}
+	}
+
+	return true;
+}
+
+int GTKNoCSDMenuReachableItems(GMenuModel *Model, int Depth) {
+	// Count items anywhere in the menu that use application or window actions
+
+	const char *Links[] = {"section", "submenu"};
+	int Count = 0;
+	gint Items = o_g_menu_model_get_n_items(Model);
+	for (gint Index = 0; Index < Items; ++Index) {
+		GVariant *Action = o_g_menu_model_get_item_attribute_value(Model,
+				Index, "action", G_VARIANT_TYPE_STRING);
+		if (Action != NULL) {
+			const char *Name = o_g_variant_get_string(Action, NULL);
+			if (strncmp(Name, "app.", 4) == 0 ||
+				strncmp(Name, "win.", 4) == 0) {
+				++Count;
+			}
+			o_g_variant_unref(Action);
+		}
+
+		for (size_t Link = 0; Link < 2 && Depth < 16; ++Link) {
+			GMenuModel *Child = o_g_menu_model_get_item_link(Model, Index,
+					Links[Link]);
+			if (Child != NULL) {
+				Count += GTKNoCSDMenuReachableItems(Child, Depth + 1);
+				o_g_object_unref((GObject *) Child);
+			}
+		}
+	}
+
+	return Count;
+}
+
+void GTKNoCSDMenuAddCandidate(struct GTKNoCSDMenuCandidates *Candidates,
+	GtkWidget *Owner, GMenuModel *Model, bool Primary) {
+	// Save a menu with what decides whether it is the main menu
+
+	if (Candidates->Count == sizeof(Candidates->List) /
+		sizeof(Candidates->List[0])) {
+		return;
+	}
+
+	struct GTKNoCSDMenuCandidate *Candidate =
+		&Candidates->List[Candidates->Count++];
+	Candidate->Owner = Owner;
+	Candidate->Model = Model;
+	Candidate->Shown = GTKNoCSDMenuShown(Owner);
+	Candidate->Primary = Primary;
+	Candidate->Score = GTKNoCSDMenuReachableItems(Model, 0);
+}
+
+void GTKNoCSDMenuCollect(GtkWidget *Widget, int Depth,
+	struct GTKNoCSDMenuCandidates *Candidates) {
+	// Collect every menu button and popover menu bar of a widget tree
+
+	if (Widget == NULL || 32 < Depth) {
+		return;
+	}
+
+	if (GTKNoCSDGtkMenuButton((GObject *) Widget)) {
+		GtkMenuButton *Button = (GtkMenuButton *) Widget;
+		GMenuModel *Model = o_gtk_menu_button_get_menu_model(Button);
+
+		// A menu set with gtk_menu_button_set_popover is still reachable
+		// through the popover, when that is a GtkPopoverMenu (Yelp)
+		if (Model == NULL) {
+			GtkPopover *Popover = o_gtk_menu_button_get_popover(Button);
+			if (GTKNoCSDGtkPopoverMenu((GObject *) Popover)) {
+				Model = o_gtk_popover_menu_get_menu_model(
+					(GtkPopoverMenu *) Popover);
+			}
+		}
+
+		if (Model != NULL) {
+			GTKNoCSDMenuAddCandidate(Candidates, Widget, Model,
+				o_gtk_menu_button_get_primary != NULL &&
+				o_gtk_menu_button_get_primary(Button));
+		}
+	}
+
+	if (GTKNoCSDGtkPopoverMenuBar((GObject *) Widget)) {
+		GMenuModel *Model = o_gtk_popover_menu_bar_get_menu_model(
+			(GtkPopoverMenuBar *) Widget);
+		if (Model != NULL) {
+			GTKNoCSDMenuAddCandidate(Candidates, Widget, Model, false);
+		}
+	}
+
+	// WARNING: Own call
+	for (GtkWidget *Child = gtk_widget_get_first_child(Widget);
+		Child != NULL; Child = o_gtk_widget_get_next_sibling(Child)) {
+		GTKNoCSDMenuCollect(Child, Depth + 1, Candidates);
+	}
+}
+
+GMenuModel *GTKNoCSDMenuFind(GtkWindow *Window, GtkWidget **Owner) {
+	// Find the main menu of a window. A window often has several menu buttons,
+	// so the one that is shown wins, then the primary one (the one F10 opens),
+	// then the one with most application and window actions, then the first
+
+	struct GTKNoCSDMenuCandidates Candidates = {0};
+
+	// The title bar is not in the child tree. Some keep the header bar in the
+	// content (Yelp), so both are searched
+	// WARNING: Own call
+	GTKNoCSDMenuCollect(gtk_window_get_titlebar(Window), 0, &Candidates);
+
+	// WARNING: Own call
+	GTKNoCSDMenuCollect(gtk_window_get_child(Window), 0, &Candidates);
+	if (Candidates.Count == 0) {
+		return NULL;
+	}
+
+	size_t Best = 0;
+	for (size_t Index = 1; Index < Candidates.Count; ++Index) {
+		struct GTKNoCSDMenuCandidate *Candidate = &Candidates.List[Index];
+		struct GTKNoCSDMenuCandidate *Current = &Candidates.List[Best];
+		if (Candidate->Shown != Current->Shown) {
+			Best = Candidate->Shown ? Index : Best;
+		} else if (Candidate->Primary != Current->Primary) {
+			Best = Candidate->Primary ? Index : Best;
+		} else if (Current->Score < Candidate->Score) {
+			Best = Index;
+		}
+	}
+
+	*Owner = Candidates.List[Best].Owner;
+	return Candidates.List[Best].Model;
+}
+
+gchar *GTKNoCSDMenuLabel(GtkApplication *Application) {
+	// Name of the menu: the name of the desktop entry, which is what panels
+	// show next to it, otherwise the application name
+
+	const char *Identifier = o_g_application_get_application_id(
+		(GApplication *) Application);
+	if (Identifier != NULL) {
+		gchar *DesktopEntry = o_g_strconcat(Identifier, ".desktop", NULL);
+		GAppInfo *Information = o_g_desktop_app_info_new(DesktopEntry);
+		o_g_free(DesktopEntry);
+		if (Information != NULL) {
+			const char *Name = o_g_app_info_get_name(Information);
+			gchar *Label = Name != NULL ? o_g_strdup(Name) : NULL;
+			o_g_object_unref((GObject *) Information);
+			if (Label != NULL) {
+				return Label;
+			}
+		}
+	}
+
+	const char *Name = o_g_get_application_name();
+	return o_g_strdup(Name != NULL ? Name : "Menu");
+}
+
+// Over D-Bus only application actions and a GtkApplicationWindow's own actions
+// can be activated. A header bar menu may also use actions installed on a
+// widget class (Yelp's About Help). For those a stand-in is added to the
+// window's actions, which activates the original from the menu's owner, the
+// same way the popover does. GTK has no getter for whether a class action is
+// enabled, so gtk_widget_action_set_enabled is hooked and saves it as data
+
+gchar *GTKNoCSDMenuKey(const char *Kind, const char *Name) {
+	// Name of the data saved on a widget for one of its class actions
+
+	return o_g_strconcat("GTKNoCSDMenu", Kind, ":", Name, NULL);
+}
+
+void GTKNoCSDMenuProxyActivate(G_GNUC_UNUSED GSimpleAction *Action,
+	GVariant *Parameter, gpointer Data) {
+	// Activate the class action from the menu's owner
+
+	struct GTKNoCSDMenuProxy *Proxy = Data;
+	if (Proxy->Owner != NULL) {
+		o_gtk_widget_activate_action_variant(Proxy->Owner, Proxy->Name,
+			Parameter);
+	}
+}
+
+void GTKNoCSDMenuProxyFree(gpointer Data, G_GNUC_UNUSED GClosure *Closure) {
+	// Free a stand-in when its action is finalized
+
+	struct GTKNoCSDMenuProxy *Proxy = Data;
+	if (Proxy->Owner != NULL) {
+		o_g_object_remove_weak_pointer((GObject *) Proxy->Owner,
+			(gpointer *) &Proxy->Owner);
+	}
+	if (Proxy->Holder != NULL) {
+		gchar *Key = GTKNoCSDMenuKey("Proxy", Proxy->Name);
+		o_g_object_set_data((GObject *) Proxy->Holder, Key, NULL);
+		o_g_free(Key);
+		o_g_object_remove_weak_pointer((GObject *) Proxy->Holder,
+			(gpointer *) &Proxy->Holder);
+	}
+	o_g_free(Proxy->Name);
+	free(Proxy);
+}
+
+GtkWidget *GTKNoCSDMenuFindClassAction(GtkWidget *Widget, const char *Name,
+	const GVariantType **ParameterType, const char **Property) {
+	// Find the widget, the given one or an ancestor, whose class has the
+	// action, with the property of a property action
+
+	// WARNING: Own call
+	for (; Widget != NULL; Widget = gtk_widget_get_parent(Widget)) {
+		GtkWidgetClass *Class =
+			(GtkWidgetClass *) ((GTypeInstance *) Widget)->g_class;
+		GType Owner;
+		const char *ActionName, *PropertyName;
+		const GVariantType *Type;
+		for (guint Index = 0; o_gtk_widget_class_query_action(Class, Index,
+			&Owner, &ActionName, &Type, &PropertyName); ++Index) {
+			if (strcmp(ActionName, Name) == 0) {
+				*ParameterType = Type;
+				*Property = PropertyName;
+				return Widget;
+			}
+		}
+	}
+
+	return NULL;
+}
+
+GVariant *GTKNoCSDMenuPropertyState(GObject *Object, GParamSpec *Property) {
+	// The state of a property action, as GTK derives it from the property type
+
+	GValue Value = G_VALUE_INIT;
+	GVariant *State = NULL;
+	GType Type = Property->value_type;
+	o_g_value_init(&Value, Type);
+	o_g_object_get_property(Object, Property->name, &Value);
+
+	if (Type == G_TYPE_BOOLEAN) {
+		State = o_g_variant_new_boolean(o_g_value_get_boolean(&Value));
+	} else if (Type == G_TYPE_INT) {
+		State = o_g_variant_new_int32(o_g_value_get_int(&Value));
+	} else if (Type == G_TYPE_UINT) {
+		State = o_g_variant_new_uint32(o_g_value_get_uint(&Value));
+	} else if (Type == G_TYPE_DOUBLE) {
+		State = o_g_variant_new_double(o_g_value_get_double(&Value));
+	} else if (Type == G_TYPE_FLOAT) {
+		State = o_g_variant_new_double(o_g_value_get_float(&Value));
+	} else if (Type == G_TYPE_STRING) {
+		const char *String = o_g_value_get_string(&Value);
+		State = o_g_variant_new_string(String != NULL ? String : "");
+	} else if (o_g_type_fundamental(Type) == G_TYPE_ENUM) {
+		GEnumClass *Class = o_g_type_class_ref(Type);
+		GEnumValue *Enumeration = o_g_enum_get_value(Class,
+				o_g_value_get_enum(&Value));
+		State = o_g_variant_new_string(Enumeration != NULL ?
+				Enumeration->value_nick : "");
+		o_g_type_class_unref(Class);
+	}
+
+	o_g_value_unset(&Value);
+	return State;
+}
