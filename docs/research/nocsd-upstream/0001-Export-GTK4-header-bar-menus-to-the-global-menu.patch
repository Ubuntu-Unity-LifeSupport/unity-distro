+void GTKNoCSDMenuShellChanged(GObject *Settings,
+	G_GNUC_UNUSED GParamSpec *Property, gpointer Application) {
+	// Remove the menubar when the shell no longer shows it
+
+	gboolean ShellShowsMenubar = TRUE;
+	o_g_object_get(Settings, "gtk-shell-shows-menubar", &ShellShowsMenubar,
+		NULL);
+	if (!ShellShowsMenubar && GTKNoCSDMenubar != NULL &&
+		o_gtk_application_get_menubar(Application) == GTKNoCSDMenubar) {
+		o_gtk_application_set_menubar(Application, NULL);
+	}
+}
