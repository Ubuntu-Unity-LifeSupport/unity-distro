+void GTKNoCSDMenuAttach(GtkWindow *Window) {
+	// Set the main menu of the window as the application's menubar
+
+	// WARNING: Own call
+	GtkApplication *Application = gtk_window_get_application(Window);
+	if (Application == NULL) {
+		return;
+	}
+
+	// Only where the shell shows the menubar. Elsewhere it would be in the
+	// window, next to the menu it copies
+	gboolean ShellShowsMenubar = FALSE;
+	o_g_object_get((GObject *) o_gtk_settings_get_default(),
+		"gtk-shell-shows-menubar", &ShellShowsMenubar, NULL);
+	if (!ShellShowsMenubar) {
+		return;
+	}
+
+	GMenuModel *Existing = o_gtk_application_get_menubar(Application);
+	if (Existing != NULL && Existing != GTKNoCSDMenubar) {
+		return;
+	}
+
+	GtkWidget *Owner = NULL;
+	GMenuModel *Model = GTKNoCSDMenuFind(Window, &Owner);
+	if (Model == NULL) {
+		return;
+	}
+
+	// The menubar belongs to the application, but window actions to the
+	// focused window, so another window only needs the stand-ins
+	GActionMap *Map = GTKNoCSDGtkApplicatonWindow((GObject *) Window) ?
+		(GActionMap *) Window : NULL;
+	GMenuModel *Cleaned = GTKNoCSDMenuClean(Model, 0, Owner, Map);
+	if (Existing != NULL) {
+		o_g_object_unref((GObject *) Cleaned);
+		return;
+	}
+
+	gchar *Label = GTKNoCSDMenuLabel(Application);
+	GMenu *Menubar = o_g_menu_new();
+	o_g_menu_append_submenu(Menubar, Label, Cleaned);
+	o_g_free(Label);
+	o_g_object_unref((GObject *) Cleaned);
+	o_gtk_application_set_menubar(Application, (GMenuModel *) Menubar);
+
+	// A withdrawn menubar may still live, it must not clear the new one
+	if (GTKNoCSDMenubar != NULL) {
+		o_g_object_remove_weak_pointer((GObject *) GTKNoCSDMenubar,
+			(gpointer *) &GTKNoCSDMenubar);
+	}
+	GTKNoCSDMenubar = (GMenuModel *) Menubar;
+	o_g_object_add_weak_pointer((GObject *) Menubar,
+		(gpointer *) &GTKNoCSDMenubar);
+	o_g_object_unref((GObject *) Menubar);
+
+	// Take it back if the shell stops showing it. Otherwise GTK would show it
+	// in the window
+	if (!GTKNoCSDMenuWatching) {
+		GTKNoCSDMenuWatching = true;
+		o_g_signal_connect_object(o_gtk_settings_get_default(),
+			"notify::gtk-shell-shows-menubar",
+			(GCallback) GTKNoCSDMenuShellChanged, Application, 0);
+	}
+}
+
+void GTKNoCSDMenuWindowRealize(GtkWidget *Widget) {
+	// Realize of GtkWindow. The menu must be set before it
+
+	// GtkApplicationWindow chains up here, it was handled in its own realize
+	if (GTKNoCSDApplicationWindowRealize == NULL ||
+		!GTKNoCSDGtkApplicatonWindow((GObject *) Widget)) {
+		GTKNoCSDMenuAttach((GtkWindow *) Widget);
+	}
+	if (GTKNoCSDWindowRealize != NULL) {
+		GTKNoCSDWindowRealize(Widget);
+	}
+}
+
+void GTKNoCSDMenuApplicationWindowRealize(GtkWidget *Widget) {
+	// Realize of GtkApplicationWindow. The menu must be set before it
+
+	GTKNoCSDMenuAttach((GtkWindow *) Widget);
+	if (GTKNoCSDApplicationWindowRealize != NULL) {
+		GTKNoCSDApplicationWindowRealize(Widget);
+	}
+}
+
+void GTKNoCSDMenuHookClass(GType Type, void(**Original)(GtkWidget *),
+	void (*Replacement)(GtkWidget *)) {
+	// Replace realize in the class of a window type. The class reference is
+	// kept, the class has to live as long as the process anyway
+
+	GtkWidgetClass *Class = o_g_type_class_ref(Type);
+	if (Class->realize == GTKNoCSDMenuWindowRealize ||
+		Class->realize == GTKNoCSDMenuApplicationWindowRealize) {
+		return;
+	}
+	*Original = Class->realize;
+	Class->realize = Replacement;
+}
