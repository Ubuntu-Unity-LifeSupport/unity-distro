+void GTKNoCSDMenuHook(void) {
+	// Hook GTK4 windows, once GTK4 and its types are known. There is no
+	// function every window goes through before it is realized, so realize is
+	// replaced in the classes of GtkWindow and GtkApplicationWindow
+
+	if (GTKNoCSDMenuHooked || GTKNoCSDNoGlobalMenu ||
+		GTKNoCSDGTKVersion != 4 || GTKNoCSDGTKWindow == 0 ||
+		GTKNoCSDGTKApplicationWindow == 0) {
+		return;
+	}
+	GTKNoCSDMenuHooked = true;
+
+	GTKNoCSDGetMenuSymbols();
+	void *Needed[] = {
+		(void *) o_gtk_menu_button_get_menu_model,
+		(void *) o_gtk_menu_button_get_popover,
+		(void *) o_gtk_popover_menu_get_menu_model,
+		(void *) o_gtk_popover_menu_bar_get_menu_model,
+		(void *) o_gtk_application_get_menubar,
+		(void *) o_gtk_application_set_menubar,
+		(void *) o_gtk_widget_is_visible,
+		(void *) o_gtk_widget_get_child_visible,
+		(void *) o_gtk_widget_class_query_action,
+		(void *) o_gtk_widget_activate_action_variant,
+		(void *) o_g_type_class_ref, (void *) o_g_type_class_unref,
+		(void *) o_g_type_fundamental, (void *) o_g_signal_connect_object,
+		(void *) o_g_object_class_find_property,
+		(void *) o_g_object_get_property,
+		(void *) o_g_object_remove_weak_pointer, (void *) o_g_value_init,
+		(void *) o_g_value_unset, (void *) o_g_value_get_boolean,
+		(void *) o_g_value_get_int, (void *) o_g_value_get_uint,
+		(void *) o_g_value_get_double, (void *) o_g_value_get_float,
+		(void *) o_g_value_get_string, (void *) o_g_value_get_enum,
+		(void *) o_g_enum_get_value, (void *) o_g_variant_new_boolean,
+		(void *) o_g_variant_new_int32, (void *) o_g_variant_new_uint32,
+		(void *) o_g_variant_new_double, (void *) o_g_variant_new_string,
+		(void *) o_g_variant_get_boolean, (void *) o_g_variant_get_string,
+		(void *) o_g_variant_is_of_type, (void *) o_g_variant_unref,
+		(void *) o_g_strdup, (void *) o_g_strconcat, (void *) o_g_menu_new,
+		(void *) o_g_menu_model_get_n_items,
+		(void *) o_g_menu_model_get_item_link,
+		(void *) o_g_menu_model_get_item_attribute_value,
+		(void *) o_g_menu_item_new_from_model,
+		(void *) o_g_menu_item_set_link,
+		(void *) o_g_menu_item_set_attribute_value,
+		(void *) o_g_menu_append_item, (void *) o_g_menu_append_submenu,
+		(void *) o_g_application_get_application_id,
+		(void *) o_g_desktop_app_info_new, (void *) o_g_app_info_get_name,
+		(void *) o_g_simple_action_new,
+		(void *) o_g_simple_action_new_stateful,
+		(void *) o_g_simple_action_set_state,
+		(void *) o_g_simple_action_set_enabled,
+		(void *) o_g_action_get_state, (void *) o_g_action_map_add_action,
+		(void *) o_g_action_map_lookup_action
+	};
+	for (size_t Index = 0; Index < sizeof(Needed) / sizeof(Needed[0]);
+		++Index) {
+		if (Needed[Index] == NULL) {
+			return;
+		}
+	}
+
+	if (GTKNoCSDGTKMenuButton == 0 || GTKNoCSDGTKPopoverMenu == 0 ||
+		GTKNoCSDGTKPopoverMenuBar == 0) {
+		return;
+	}
+
+	GTKNoCSDMenuReady = true;
+	GTKNoCSDMenuHookClass(GTKNoCSDGTKWindow, &GTKNoCSDWindowRealize,
+		GTKNoCSDMenuWindowRealize);
+	GTKNoCSDMenuHookClass(GTKNoCSDGTKApplicationWindow,
+		&GTKNoCSDApplicationWindowRealize,
+		GTKNoCSDMenuApplicationWindowRealize);
+}
