From 5d6492d5bd97d676547549bb6146914e0887b497 Mon Sep 17 00:00:00 2001
From: NeiroNext <mihail.rozshko@gmail.com>
Date: Mon, 28 Sep 2026 09:57:07 +0000
Subject: [PATCH 2/2] engine-eds: drop the unreachable no-time guard; release
 +unity3

EDS generates no instance for a component with neither DTSTART nor DUE
(e_cal_recur_generate_instances_sync: intersects_interval() is FALSE for a
null time), so such a component never reaches get_appointment(). Measured
without the guard against a live EDS with plain, RRULE, RECURRENCE-ID,
VALARM and RDATE variants: no appointment without a start, no abort. The
due-date fallback for tasks without DTSTART (LP: #1848969, #2099742) stays.

Assisted-by: LLM claude-opus-5-5
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 debian/changelog   | 14 ++++++++++++++
 src/engine-eds.cpp | 16 +++++-----------
 2 files changed, 19 insertions(+), 11 deletions(-)

diff --git a/debian/changelog b/debian/changelog
index d2ce45d..430e338 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,17 @@
+indicator-datetime (15.10+21.04.20210304-0ubuntu6+unity3) resolute; urgency=medium
+
+  * src/engine-eds.cpp: drop +unity2's guard against components without any
+    time. EDS never hands such a component to the indicator: it generates
+    no instance for a component with neither DTSTART nor DUE (measured
+    with RRULE, RECURRENCE-ID and VALARM variants; an RDATE-only task comes
+    with its RDATE as start). The fix for tasks with only a due date stays
+    (UNITY-20260927-026).
+  * tests/run-eds-ics-test.sh: create the EDS tasks directory before
+    copying the test calendar; git does not keep the empty directory that
+    the release tarball ships, so builds from git failed every EDS test.
+
+ -- Ubuntu Unity Life Support <mihail.rozshko@gmail.com>  Mon, 28 Sep 2026 09:57:07 +0000
+
 indicator-datetime (15.10+21.04.20210304-0ubuntu6+unity2) resolute; urgency=medium
 
   * src/engine-eds.cpp: a task with only a due date (as Nextcloud Tasks
diff --git a/src/engine-eds.cpp b/src/engine-eds.cpp
index cee2855..3bd921d 100644
--- a/src/engine-eds.cpp
+++ b/src/engine-eds.cpp
@@ -1081,13 +1081,10 @@ private:
         }
         g_slist_free_full(categ_list, g_free);
 
-        // a component with neither a start nor a due date has no time
-        // (LP: #1848969, #2099742)
-        if (baseline.begin.is_set())
-            g_debug("%s got appointment from %s to %s: %s", G_STRLOC,
-                    baseline.begin.format("%F %T %z").c_str(),
-                    baseline.end.format("%F %T %z").c_str(),
-                    i_cal_component_as_ical_string(icc) /* string owned by ical */);
+        g_debug("%s got appointment from %s to %s: %s", G_STRLOC,
+                baseline.begin.format("%F %T %z").c_str(),
+                baseline.end.format("%F %T %z").c_str(),
+                i_cal_component_as_ical_string(icc) /* string owned by ical */);
 
         return baseline;
     }
@@ -1176,10 +1173,7 @@ private:
         {
             Appointment appointment = get_appointment(subtask->client, subtask->cancellable, component, gtz);
             appointment.color = subtask->color;
-
-            // nothing to show without a time
-            if (appointment.begin.is_set())
-                subtask->task->appointments.push_back(appointment);
+            subtask->task->appointments.push_back(appointment);
         }
     }
 
