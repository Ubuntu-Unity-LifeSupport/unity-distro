 if(POLICY CMP0011)
   cmake_policy(SET CMP0011 NEW)
 endif(POLICY CMP0011)
diff --git a/cmake/UseGlibGeneration.cmake b/cmake/UseGlibGeneration.cmake
index 67e34b9..5b92090 100644
--- a/cmake/UseGlibGeneration.cmake
+++ b/cmake/UseGlibGeneration.cmake
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 2.6)
+cmake_minimum_required(VERSION 3.10)
 if(POLICY CMP0011)
   cmake_policy(SET CMP0011 NEW)
 endif(POLICY CMP0011)
diff --git a/cmake/UseMscgen.cmake b/cmake/UseMscgen.cmake
index 5e3a1bf..f364bd7 100644
--- a/cmake/UseMscgen.cmake
+++ b/cmake/UseMscgen.cmake
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 2.6)
+cmake_minimum_required(VERSION 3.10)
 
 find_program(MSCGEN_EXECUTABLE NAMES mscgen DOC "mscgen executable")
 if(NOT MSCGEN_EXECUTABLE)
diff --git a/debian/changelog b/debian/changelog
index 9075d72..0279d2e 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,16 @@
+hud (14.10+17.10.20170619-0ubuntu6+unity1) resolute; urgency=medium
+
+  * CMakeLists.txt, cmake/*.cmake: require CMake 3.10. CMake 4 removed
+    compatibility with versions before 3.5, so the package no longer
+    configured in resolute.
+  * debian/control: build-depend on systemd-dev instead of systemd. systemd.pc
+    moved there, so systemduserunitdir came out empty and CMake refused to
+    install hud.service and window-stack-bridge.service.
+  * CMakeLists.txt: build with -std=c++17. The googletest of resolute needs
+    at least C++17, so the tests no longer compiled.
+
+ -- Ubuntu Unity Life Support <mihail.rozshko@gmail.com>  Sat, 26 Sep 2026 18:16:27 +0000
+
 hud (14.10+17.10.20170619-0ubuntu6) noble; urgency=medium
 
   * Bump C++ version to C++14 to make googletest happy.
diff --git a/debian/control b/debian/control
index 6edfcf2..0723013 100644
--- a/debian/control
+++ b/debian/control
@@ -30,7 +30,7 @@ Build-Depends: cmake (>= 3.4),
                python3-setuptools,
                qtbase5-dev,
                qtdbustest-runner,
-               systemd,
+               systemd-dev,
                valac,
                xvfb,
