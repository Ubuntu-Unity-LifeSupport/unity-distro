diff --git a/cmake/UseGdbusCodegen.cmake b/cmake/UseGdbusCodegen.cmake
index aa23ca3..c50aff5 100644
--- a/cmake/UseGdbusCodegen.cmake
+++ b/cmake/UseGdbusCodegen.cmake
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 2.6)
