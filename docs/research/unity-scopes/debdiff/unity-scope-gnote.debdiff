diff -u unity-scope-gnote-0.1+13.10.20130723/debian/changelog unity-scope-gnote-0.1+13.10.20130723/debian/changelog
--- unity-scope-gnote-0.1+13.10.20130723/debian/changelog
+++ unity-scope-gnote-0.1+13.10.20130723/debian/changelog
@@ -1,3 +1,15 @@
+unity-scope-gnote (0.1+13.10.20130723-0ubuntu4+unity1) resolute; urgency=medium
+
+  * debian/rules: do not install /usr/lib/python3/dist-packages/__init__.py,
+    which every unity-scope-* package shipped, so no two of them could be
+    installed together.
+  * src/unity_gnote_daemon.py: retry for up to three seconds when Gnote's
+    RemoteControl object is not there yet. The first call starts Gnote by
+    D-Bus activation and Gnote 49 registers the object only once it is up,
+    so with Gnote not already running every search came back empty.
+
+ -- Ubuntu Unity Life Support <mihail.rozshko@gmail.com>  Sat, 26 Sep 2026 13:10:35 +0000
+
 unity-scope-gnote (0.1+13.10.20130723-0ubuntu4) resolute; urgency=medium
 
   * No-change mass rebuild for Ubuntu 26.04 (LP: #2132257)
diff -u unity-scope-gnote-0.1+13.10.20130723/debian/rules unity-scope-gnote-0.1+13.10.20130723/debian/rules
--- unity-scope-gnote-0.1+13.10.20130723/debian/rules
+++ unity-scope-gnote-0.1+13.10.20130723/debian/rules
@@ -16,3 +16,7 @@
 
 override_dh_auto_install:
 	python3 setup.py install --root=$(CURDIR)/debian/unity-scope-gnote --install-layout=deb
+	# Every unity-scope-* installed src/__init__.py as
+	# /usr/lib/python3/dist-packages/__init__.py, so no two of them could be
+	# installed together; the scope loads from /usr/share/unity-scopes
+	rm -f $(CURDIR)/debian/unity-scope-gnote/usr/lib/python3/dist-packages/__init__.py
only in patch2:
unchanged:
--- unity-scope-gnote-0.1+13.10.20130723.orig/src/unity_gnote_daemon.py
+++ unity-scope-gnote-0.1+13.10.20130723/src/unity_gnote_daemon.py
@@ -18,6 +18,7 @@
 from gi.repository import Gio, GLib
 import gettext
 import datetime
+import time
 import re
 import urllib.parse
 import urllib.request
@@ -86,10 +87,21 @@
     results = []
     if not gnote:
         return results
-    if search:
-    	gnote_search = gnote.SearchNotes('(sb)', search, False)
-    else:
-        gnote_search = gnote.ListAllNotes()
+    # Gnote is started by D-Bus activation on the first call and registers
+    # its RemoteControl object only once it is up, so the first calls fail
+    # with UnknownMethod; retry for up to three seconds
+    for attempt in range(15):
+        try:
+            if search:
+                gnote_search = gnote.SearchNotes('(sb)', search, False)
+            else:
+                gnote_search = gnote.ListAllNotes()
+            break
+        except GLib.Error as error:
+            if attempt == 14:
+                print(error)
+                return results
+            time.sleep(0.2)
     for note in gnote_search:
         timestamp = gnote.GetNoteChangeDate('(s)', note)
         last_changed = datetime.datetime.fromtimestamp(timestamp).strftime('%x')
