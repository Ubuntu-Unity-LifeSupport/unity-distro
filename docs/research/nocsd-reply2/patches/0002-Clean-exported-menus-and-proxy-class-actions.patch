+		(GMenuModel *) o_g_object_ref((GObject *) Model);
 	if (Existing != NULL) {
 		o_g_object_unref((GObject *) Cleaned);
 		return;
@@ -4551,6 +4982,32 @@ void GTKNoCSDMenuAttach(GtkWindow *Window) {
 	o_g_object_unref((GObject *) Menubar);
 }
 
+void gtk_widget_action_set_enabled(GtkWidget *Widget, const char *ActionName,
+	gboolean Enabled) {
+	// Entry point used by applications to enable or disable a class action.
+	// Hook it, to save the state for the stand-ins of the global menu
+
+	GTKNoCSDGetReferences(true);
+	if (o_gtk_widget_action_set_enabled != NULL) {
+		o_gtk_widget_action_set_enabled(Widget, ActionName, Enabled);
+	}
+
+	if (!GTKNoCSDMenuProxyReady || Widget == NULL || ActionName == NULL) {
+		return;
+	}
+
+	gchar *Key = GTKNoCSDMenuKey("Enabled", ActionName);
+	o_g_object_set_data((GObject *) Widget, Key,
+		GINT_TO_POINTER(Enabled ? 1 : 2));
+	o_g_free(Key);
+	Key = GTKNoCSDMenuKey("Proxy", ActionName);
+	GSimpleAction *Proxy = o_g_object_get_data((GObject *) Widget, Key);
+	o_g_free(Key);
+	if (Proxy != NULL) {
+		o_g_simple_action_set_enabled(Proxy, Enabled);
+	}
+}
