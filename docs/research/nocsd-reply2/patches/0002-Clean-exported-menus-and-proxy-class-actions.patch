+	LOAD_SYMBOL(Library, g_type_fundamental);
+	LOAD_SYMBOL(Library, g_object_class_find_property);
+	LOAD_SYMBOL(Library, g_object_get_property);
+	LOAD_SYMBOL(Library, g_value_init);
+	LOAD_SYMBOL(Library, g_value_unset);
+	LOAD_SYMBOL(Library, g_value_get_boolean);
+	LOAD_SYMBOL(Library, g_value_get_int);
+	LOAD_SYMBOL(Library, g_value_get_uint);
+	LOAD_SYMBOL(Library, g_value_get_double);
+	LOAD_SYMBOL(Library, g_value_get_float);
+	LOAD_SYMBOL(Library, g_value_get_string);
+	LOAD_SYMBOL(Library, g_value_get_enum);
+	LOAD_SYMBOL(Library, g_enum_get_value);
+	LOAD_SYMBOL(Library, g_variant_new_boolean);
+	LOAD_SYMBOL(Library, g_variant_new_int32);
+	LOAD_SYMBOL(Library, g_variant_new_uint32);
+	LOAD_SYMBOL(Library, g_variant_new_double);
+	LOAD_SYMBOL(Library, g_variant_new_string);
+	LOAD_SYMBOL(Library, g_variant_get_boolean);
+	LOAD_SYMBOL(Library, g_variant_is_of_type);
+	dlclose(Library);
+
+	Library = GTKNoCSDGetLibrary("libgio-2.0.so.0", true);
+	LOAD_SYMBOL(Library, g_menu_item_new_from_model);
+	LOAD_SYMBOL(Library, g_menu_item_set_link);
+	LOAD_SYMBOL(Library, g_menu_item_set_attribute_value);
+	LOAD_SYMBOL(Library, g_menu_append_item);
+	LOAD_SYMBOL(Library, g_simple_action_new);
+	LOAD_SYMBOL(Library, g_simple_action_new_stateful);
+	LOAD_SYMBOL(Library, g_simple_action_set_state);
+	LOAD_SYMBOL(Library, g_simple_action_set_enabled);
+	LOAD_SYMBOL(Library, g_action_get_state);
+	LOAD_SYMBOL(Library, g_action_map_add_action);
+	LOAD_SYMBOL(Library, g_action_map_lookup_action);
+	dlclose(Library);
+
+	Library = GTKNoCSDGetLibrary(GTKNoCSDNewGTKName, true);
+	LOAD_SYMBOL(Library, gtk_widget_class_query_action);
+	LOAD_SYMBOL(Library, gtk_widget_activate_action_variant);
+	dlclose(Library);
+
+	void *Needed[] = {
+		(void *) o_gtk_widget_class_query_action,
+		(void *) o_gtk_widget_activate_action_variant,
+		(void *) o_g_type_fundamental,
+		(void *) o_g_object_class_find_property,
+		(void *) o_g_object_get_property,
+		(void *) o_g_value_init,
+		(void *) o_g_value_unset,
+		(void *) o_g_value_get_boolean,
+		(void *) o_g_value_get_int,
+		(void *) o_g_value_get_uint,
+		(void *) o_g_value_get_double,
+		(void *) o_g_value_get_float,
+		(void *) o_g_value_get_string,
+		(void *) o_g_value_get_enum,
+		(void *) o_g_enum_get_value,
+		(void *) o_g_variant_new_boolean,
+		(void *) o_g_variant_new_int32,
+		(void *) o_g_variant_new_uint32,
+		(void *) o_g_variant_new_double,
+		(void *) o_g_variant_new_string,
+		(void *) o_g_variant_get_boolean,
+		(void *) o_g_variant_is_of_type,
+		(void *) o_g_menu_item_new_from_model,
+		(void *) o_g_menu_item_set_link,
+		(void *) o_g_menu_item_set_attribute_value,
+		(void *) o_g_menu_append_item,
+		(void *) o_g_simple_action_new,
+		(void *) o_g_simple_action_new_stateful,
+		(void *) o_g_simple_action_set_state,
+		(void *) o_g_simple_action_set_enabled,
