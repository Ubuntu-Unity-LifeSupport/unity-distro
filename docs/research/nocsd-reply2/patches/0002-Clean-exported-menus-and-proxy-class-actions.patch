+
+gchar *GTKNoCSDMenuKey(const char *Kind, const char *Name) {
+	// Name of the data saved on a widget for one of its class actions
+
+	return o_g_strconcat("GTKNoCSDMenu", Kind, ":", Name, NULL);
+}
+
+void GTKNoCSDMenuProxyActivate(G_GNUC_UNUSED GSimpleAction *Action,
+	GVariant *Parameter, gpointer Data) {
+	// Activate the class action from the menu's owner
+
+	struct GTKNoCSDMenuProxy *Proxy = Data;
+	if (Proxy->Owner != NULL) {
+		o_gtk_widget_activate_action_variant(Proxy->Owner, Proxy->Name,
+			Parameter);
+	}
+}
+
+void GTKNoCSDMenuProxyFree(gpointer Data, G_GNUC_UNUSED GClosure *Closure) {
+	// Free a stand-in when its action is finalized
+
+	struct GTKNoCSDMenuProxy *Proxy = Data;
+	if (Proxy->Owner != NULL) {
+		o_g_object_remove_weak_pointer((GObject *) Proxy->Owner,
+			(gpointer *) &Proxy->Owner);
+	}
+	if (Proxy->Holder != NULL) {
+		gchar *Key = GTKNoCSDMenuKey("Proxy", Proxy->Name);
+		o_g_object_set_data((GObject *) Proxy->Holder, Key, NULL);
+		o_g_free(Key);
+		o_g_object_remove_weak_pointer((GObject *) Proxy->Holder,
+			(gpointer *) &Proxy->Holder);
+	}
+	o_g_free(Proxy->Name);
+	free(Proxy);
+}
+
+GtkWidget *GTKNoCSDMenuFindClassAction(GtkWidget *Widget, const char *Name,
+	const GVariantType **ParameterType, const char **Property) {
+	// Find the widget, the given one or an ancestor, whose class has the
+	// action, with the property of a property action
+
+	// WARNING: Own call
+	for (; Widget != NULL; Widget = gtk_widget_get_parent(Widget)) {
+		GtkWidgetClass *Class =
+			(GtkWidgetClass *) ((GTypeInstance *) Widget)->g_class;
+		GType Owner;
+		const char *ActionName, *PropertyName;
+		const GVariantType *Type;
+		for (guint Index = 0; o_gtk_widget_class_query_action(Class, Index,
+			&Owner, &ActionName, &Type, &PropertyName); ++Index) {
+			if (strcmp(ActionName, Name) == 0) {
+				*ParameterType = Type;
+				*Property = PropertyName;
+				return Widget;
+			}
+		}
+	}
+
+	return NULL;
+}
+
+GVariant *GTKNoCSDMenuPropertyState(GObject *Object, GParamSpec *Property) {
+	// The state of a property action, as GTK derives it from the property type
+
+	GValue Value = G_VALUE_INIT;
+	GVariant *State = NULL;
+	GType Type = Property->value_type;
+	o_g_value_init(&Value, Type);
+	o_g_object_get_property(Object, Property->name, &Value);
+
+	if (Type == G_TYPE_BOOLEAN) {
+		State = o_g_variant_new_boolean(o_g_value_get_boolean(&Value));
+	} else if (Type == G_TYPE_INT) {
+		State = o_g_variant_new_int32(o_g_value_get_int(&Value));
+	} else if (Type == G_TYPE_UINT) {
+		State = o_g_variant_new_uint32(o_g_value_get_uint(&Value));
+	} else if (Type == G_TYPE_DOUBLE) {
+		State = o_g_variant_new_double(o_g_value_get_double(&Value));
+	} else if (Type == G_TYPE_FLOAT) {
+		State = o_g_variant_new_double(o_g_value_get_float(&Value));
+	} else if (Type == G_TYPE_STRING) {
+		const char *String = o_g_value_get_string(&Value);
+		State = o_g_variant_new_string(String != NULL ? String : "");
+	} else if (o_g_type_fundamental(Type) == G_TYPE_ENUM) {
+		GEnumClass *Class = o_g_type_class_ref(Type);
+		GEnumValue *Enumeration = o_g_enum_get_value(Class,
+				o_g_value_get_enum(&Value));
+		State = o_g_variant_new_string(Enumeration != NULL ?
+				Enumeration->value_nick : "");
+		o_g_type_class_unref(Class);
+	}
+
+	o_g_value_unset(&Value);
+	return State;
+}
+
+void GTKNoCSDMenuPropertyNotified(GObject *Holder, GParamSpec *Property,
+	gpointer Action) {
+	// Follow the property of a property action
+
+	GVariant *State = GTKNoCSDMenuPropertyState(Holder, Property);
+	if (State != NULL) {
+		o_g_simple_action_set_state(Action, State);
+	}
+}
+
+void GTKNoCSDMenuProxyChangeState(GSimpleAction *Action, GVariant *Value,
+	gpointer Data) {
+	// A state change asked over D-Bus goes to the property like activation.
+	// The new state comes back through notify
+
+	struct GTKNoCSDMenuProxy *Proxy = Data;
+	if (Proxy->Owner == NULL) {
+		return;
+	}
+
+	if (!o_g_variant_is_of_type(Value, G_VARIANT_TYPE_BOOLEAN)) {
+		o_gtk_widget_activate_action_variant(Proxy->Owner, Proxy->Name,
+			Value);
+		return;
+	}
+
+	GVariant *Current = o_g_action_get_state((GAction *) Action);
+	bool Differs = Current == NULL ||
+		o_g_variant_get_boolean(Current) != o_g_variant_get_boolean(Value);
+	if (Current != NULL) {
+		o_g_variant_unref(Current);
+	}
+	if (Differs) {
+		o_gtk_widget_activate_action_variant(Proxy->Owner, Proxy->Name, NULL);
+	}
+}
+
+gchar *GTKNoCSDMenuProxyFor(const char *Name, GtkWidget *Owner,
+	GActionMap *Map) {
+	// The action name the exported item uses: a stand-in in the window's
+	// actions for a class action, otherwise NULL to keep the name
+
+	const GVariantType *ParameterType = NULL;
+	const char *Property = NULL;
+	GtkWidget *Holder = GTKNoCSDMenuFindClassAction(Owner, Name,
+			&ParameterType, &Property);
+	if (Holder == NULL) {
+		return NULL;
+	}
+
+	// No dots: the whole name after win. is one action name
+	gchar *Local = o_g_strconcat("gtk-nocsd-", Name, NULL);
+	for (gchar *Character = Local; *Character != '\0'; ++Character) {
+		if (*Character == '.') {
+			*Character = '-';
+		}
+	}
+
+	if (o_g_action_map_lookup_action(Map, Local) == NULL) {
+		GParamSpec *Specification = NULL;
+		GVariant *State = NULL;
+		if (Property != NULL) {
+			Specification = o_g_object_class_find_property(
+				(GObjectClass *) ((GTypeInstance *) Holder)->g_class,
+				Property);
+			if (Specification != NULL) {
+				State = GTKNoCSDMenuPropertyState((GObject *) Holder,
+						Specification);
+			}
+
+			// A property type GTK itself does not turn into an action
+			if (State == NULL) {
+				o_g_free(Local);
+				return NULL;
+			}
+		}
+
+		struct GTKNoCSDMenuProxy *Proxy = calloc(1,
+				sizeof(struct GTKNoCSDMenuProxy));
+		if (Proxy == NULL) {
+			o_g_free(Local);
+			return NULL;
+		}
+		Proxy->Owner = Owner;
+		Proxy->Holder = Holder;
+		Proxy->Name = o_g_strdup(Name);
+		o_g_object_add_weak_pointer((GObject *) Owner,
+			(gpointer *) &Proxy->Owner);
+		o_g_object_add_weak_pointer((GObject *) Holder,
+			(gpointer *) &Proxy->Holder);
+
+		GSimpleAction *Action = State != NULL ?
+			o_g_simple_action_new_stateful(Local, ParameterType, State) :
+			o_g_simple_action_new(Local, ParameterType);
+		o_g_signal_connect_data(Action, "activate",
+			(GCallback) GTKNoCSDMenuProxyActivate, Proxy,
+			GTKNoCSDMenuProxyFree, 0);
+		if (State != NULL) {
+			o_g_signal_connect_data(Action, "change-state",
+				(GCallback) GTKNoCSDMenuProxyChangeState, Proxy, NULL, 0);
+			gchar *Signal = o_g_strconcat("notify::", Specification->name,
+					NULL);
+			o_g_signal_connect_object(Holder, Signal,
+				(GCallback) GTKNoCSDMenuPropertyNotified, Action, 0);
+			o_g_free(Signal);
+		}
+
+		// Start from what the application has set so far
+		gchar *Key = GTKNoCSDMenuKey("Enabled", Name);
+		o_g_simple_action_set_enabled(Action,
+			o_g_object_get_data((GObject *) Holder, Key) !=
+			GINT_TO_POINTER(2));
+		o_g_free(Key);
+		Key = GTKNoCSDMenuKey("Proxy", Name);
+		o_g_object_set_data((GObject *) Holder, Key, Action);
+		o_g_free(Key);
+
+		o_g_action_map_add_action(Map, (GAction *) Action);
+		o_g_object_unref((GObject *) Action);
+	}
+
+	gchar *Exported = o_g_strconcat("win.", Local, NULL);
+	o_g_free(Local);
+	return Exported;
+}
+
+GMenuModel *GTKNoCSDMenuClean(GMenuModel *Model, int Depth, GtkWidget *Owner,
+	GActionMap *Map) {
+	// Copy the menu without items that embed a widget, which cannot cross
+	// D-Bus (Yelp's zoom), and without sections left empty by that. Class
+	// actions are replaced with their stand-ins
+
+	const char *Links[] = {"section", "submenu"};
+	GMenu *Menu = o_g_menu_new();
+	gint Items = o_g_menu_model_get_n_items(Model);
+	for (gint Index = 0; Index < Items; ++Index) {
+		GVariant *Custom = o_g_menu_model_get_item_attribute_value(Model,
+				Index, "custom", NULL);
+		if (Custom != NULL) {
+			o_g_variant_unref(Custom);
+			continue;
+		}
+
+		GMenuItem *Item = o_g_menu_item_new_from_model(Model, Index);
+		GVariant *Action = Map == NULL ? NULL :
+			o_g_menu_model_get_item_attribute_value(Model, Index, "action",
+				G_VARIANT_TYPE_STRING);
+		if (Action != NULL) {
+			gchar *Exported = GTKNoCSDMenuProxyFor(
+				o_g_variant_get_string(Action, NULL), Owner, Map);
+			if (Exported != NULL) {
+				o_g_menu_item_set_attribute_value(Item, "action",
+					o_g_variant_new_string(Exported));
+				o_g_free(Exported);
+			}
+			o_g_variant_unref(Action);
+		}
+
+		bool Keep = true;
+		for (size_t Link = 0; Link < 2 && Depth < 16; ++Link) {
+			GMenuModel *Child = o_g_menu_model_get_item_link(Model, Index,
+					Links[Link]);
+			if (Child == NULL) {
+				continue;
+			}
+
+			GMenuModel *Cleaned = GTKNoCSDMenuClean(Child, Depth + 1, Owner,
+					Map);
+			o_g_object_unref((GObject *) Child);
+			if (o_g_menu_model_get_n_items(Cleaned) == 0) {
+				Keep = false;
+			} else {
+				o_g_menu_item_set_link(Item, Links[Link], Cleaned);
+			}
+			o_g_object_unref((GObject *) Cleaned);
+		}
+
+		if (Keep) {
+			o_g_menu_append_item(Menu, Item);
+		}
+		o_g_object_unref((GObject *) Item);
+	}
+
+	return (GMenuModel *) Menu;
 }
 
 void GTKNoCSDMenuAttach(GtkWindow *Window) {
@@ -4527,7 +4951,14 @@ void GTKNoCSDMenuAttach(GtkWindow *Window) {
 	if (Model == NULL) {
