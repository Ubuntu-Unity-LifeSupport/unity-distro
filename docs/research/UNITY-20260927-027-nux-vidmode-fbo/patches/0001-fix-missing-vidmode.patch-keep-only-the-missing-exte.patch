From 336ec683fa5898516b8f30374ebf77eae985d65b Mon Sep 17 00:00:00 2001
From: NeiroNext <mihail.rozshko@gmail.com>
Date: Mon, 28 Sep 2026 15:02:55 +0000
Subject: [PATCH 1/5] fix-missing-vidmode.patch: keep only the
 missing-extension fix

Drop the NULL after the fullscreen free (moved to its own patch) and the
free of an old list before a new query, which guarded a second
CreateOpenGLWindow on one display that nothing makes.

Assisted-by: LLM claude-opus-5-5
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 debian/patches/fix-missing-vidmode.patch | 22 ++--------------------
 1 file changed, 2 insertions(+), 20 deletions(-)

diff --git a/debian/patches/fix-missing-vidmode.patch b/debian/patches/fix-missing-vidmode.patch
index 0615c58..bb143db 100644
--- a/debian/patches/fix-missing-vidmode.patch
+++ b/debian/patches/fix-missing-vidmode.patch
@@ -8,19 +8,14 @@ Description: Do not crash when the X server has no XF86VidMode extension
  Query the extension first and use the mode list only when it was returned and
  is not empty. Without it, fullscreen falls back to a normal window, as it
  already does when no mode matches the requested size.
- .
- Also set the mode list pointer to NULL after it is freed in the fullscreen
- path, since the destructor frees it again, and free a previous list before
- querying a new one when a window is created again. Both found by reading;
- the double free was not reproduced.
 Author: Ubuntu Unity Life Support <mihail.rozshko@gmail.com>
 Forwarded: no
-Last-Update: 2026-09-24
+Last-Update: 2026-09-28
 Index: nux/NuxGraphics/GraphicsDisplayX11.cpp
 ===================================================================
 --- nux.orig/NuxGraphics/GraphicsDisplayX11.cpp
 +++ nux/NuxGraphics/GraphicsDisplayX11.cpp
-@@ -288,13 +288,32 @@ namespace nux
+@@ -288,13 +288,28 @@ namespace nux
      }
  
      m_X11Screen = DefaultScreen(m_X11Display);
@@ -34,10 +29,6 @@ Index: nux/NuxGraphics/GraphicsDisplayX11.cpp
 +    // XFree86-VidModeExtension is optional: Xvfb and other servers do not
 +    // have it. Without it there is no mode list, so no fullscreen mode switch,
 +    // but a window can still be created.
-+    XFree(m_X11VideoModes);
-+    m_X11VideoModes = NULL;
-+    m_NumVideoModes = 0;
-+
 +    int vidmode_event, vidmode_error;
 +    if (XF86VidModeQueryExtension(m_X11Display, &vidmode_event, &vidmode_error)
 +        && XF86VidModeQueryVersion(m_X11Display, &_x11_major, &_x11_minor)
@@ -56,12 +47,3 @@ Index: nux/NuxGraphics/GraphicsDisplayX11.cpp
  
      int best_mode = -1;
      if (fullscreen_)               // Attempt Fullscreen Mode?
-@@ -593,6 +612,8 @@ namespace nux
-       //Width = m_X11VideoModes[best_mode]->hdisplay;
-       //Height = m_X11VideoModes[best_mode]->vdisplay;
-       XFree(m_X11VideoModes);
-+      m_X11VideoModes = NULL; // also freed in the destructor
-+      m_NumVideoModes = 0;
- 
-       /* create a fullscreen window */
