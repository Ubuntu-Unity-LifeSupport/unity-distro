From ad4da6a2bcc14382c2bfef5e50eab9ca1a359a4a Mon Sep 17 00:00:00 2001
From: NeiroNext <mihail.rozshko@gmail.com>
Date: Mon, 28 Sep 2026 15:02:55 +0000
Subject: [PATCH 3/8] fix-fbo-attachment-arrays.patch: add an in-tree test (LP:
 #2160298)

Assisted-by: LLM claude-opus-5-5
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../patches/fix-fbo-attachment-arrays.patch   | 81 ++++++++++++++++++-
 1 file changed, 78 insertions(+), 3 deletions(-)

diff --git a/debian/patches/fix-fbo-attachment-arrays.patch b/debian/patches/fix-fbo-attachment-arrays.patch
index 3953001..64b7997 100644
--- a/debian/patches/fix-fbo-attachment-arrays.patch
+++ b/debian/patches/fix-fbo-attachment-arrays.patch
@@ -7,13 +7,19 @@ Description: Keep the FBO colour attachment vectors sized
  behaviour that happens to work (the capacity is still there), aborts under
  -D_GLIBCXX_ASSERTIONS, and never releases the attachments' references, since
  the vector's destructor sees no elements. Reset the elements instead.
+ .
+ The test (gtest-nuxgraphics, TestFrameBufferObject) attaches a texture and
+ checks that the attachment reads back and that the FBO releases the
+ texture's reference when it goes away; without the fix the reference leaks.
 Author: Ubuntu Unity Life Support <mihail.rozshko@gmail.com>
 Bug-Ubuntu: https://bugs.launchpad.net/ubuntu/+source/nux/+bug/2160298
 Forwarded: no
-Last-Update: 2026-09-24
+Last-Update: 2026-09-28
 ---
---- a/NuxGraphics/IOpenGLFrameBufferObject.cpp
-+++ b/NuxGraphics/IOpenGLFrameBufferObject.cpp
+Index: nux/NuxGraphics/IOpenGLFrameBufferObject.cpp
+===================================================================
+--- nux.orig/NuxGraphics/IOpenGLFrameBufferObject.cpp
++++ nux/NuxGraphics/IOpenGLFrameBufferObject.cpp
 @@ -69,8 +69,13 @@ namespace nux
    {
      Deactivate();
@@ -30,3 +36,72 @@ Last-Update: 2026-09-24
  
      depth_surface_attachment_ = ObjectPtr<IOpenGLSurface> (0);
      stencil_surface_attachment_ = ObjectPtr<IOpenGLSurface> (0);
+Index: nux/tests/Makefile.am
+===================================================================
+--- nux.orig/tests/Makefile.am
++++ nux/tests/Makefile.am
+@@ -131,7 +131,8 @@ gtest_nux_slow_LDFLAGS = $(GTestLDFlags)
+ gtest_nuxgraphics_SOURCES = \
+   gtest-nuxgraphics-main.cpp \
+   gtest-nuxgraphics-texture.cpp \
+-  gtest-nuxgraphics-graphic-display.cpp
++  gtest-nuxgraphics-graphic-display.cpp \
++  gtest-nuxgraphics-fbo.cpp
+ 
+ gtest_nuxgraphics_CPPFLAGS = $(GTestFlags) $(NUX_GRAPHICS_CFLAGS)
+ gtest_nuxgraphics_LDADD = $(GTestLibs) $(NUX_GRAPHICS_LIBS)
+Index: nux/tests/gtest-nuxgraphics-fbo.cpp
+===================================================================
+--- /dev/null
++++ nux/tests/gtest-nuxgraphics-fbo.cpp
+@@ -0,0 +1,50 @@
++#include <memory>
++#include <gmock/gmock.h>
++
++#include "Nux/Nux.h"
++#include "NuxGraphics/GraphicsDisplay.h"
++#include "NuxGraphics/GpuDevice.h"
++#include "NuxGraphics/IOpenGLFrameBufferObject.h"
++
++using namespace testing;
++
++namespace {
++
++struct TestFrameBufferObject : Test
++{
++  virtual void SetUp()
++  {
++    nux::NuxInitialize(0);
++    wnd_thread.reset(nux::CreateNuxWindow("nux::TestFrameBufferObject", 300, 200, nux::WINDOWSTYLE_NORMAL, NULL, false, NULL, NULL));
++    ASSERT_NE(nux::GetGraphicsDisplay(), nullptr);
++    gpu = nux::GetGraphicsDisplay()->GetGpuDevice();
++    ASSERT_NE(gpu, nullptr);
++  }
++
++  std::unique_ptr<nux::WindowThread> wnd_thread;
++  nux::GpuDevice* gpu;
++};
++
++// FormatFrameBufferObject() used to clear the attachment vectors right after
++// they were sized, so attaching indexed an empty vector and the FBO never
++// released what was attached (LP: #2160298).
++TEST_F(TestFrameBufferObject, ColourAttachmentIsKeptAndReleased)
++{
++  nux::ObjectPtr<nux::IOpenGLBaseTexture> texture =
++    gpu->CreateTexture(64, 64, 1, nux::BITFMT_R8G8B8A8, NUX_TRACKER_LOCATION);
++  ASSERT_TRUE(texture.IsValid());
++  int refs_before = texture->GetReferenceCount();
++
++  {
++    nux::ObjectPtr<nux::IOpenGLFrameBufferObject> fbo = gpu->CreateFrameBufferObject();
++    ASSERT_TRUE(fbo.IsValid());
++    fbo->FormatFrameBufferObject(64, 64, nux::BITFMT_R8G8B8A8);
++    fbo->SetTextureAttachment(0, texture, 0);
++    EXPECT_TRUE(fbo->TextureAttachment(0) == texture);
++    EXPECT_GT(texture->GetReferenceCount(), refs_before);
++  }
++
++  EXPECT_EQ(texture->GetReferenceCount(), refs_before);
++}
++
++}
-- 
2.53.0

