Index: nux/tests/gtest-nuxgraphics-fbo.cpp
===================================================================
--- /dev/null
+++ nux/tests/gtest-nuxgraphics-fbo.cpp
@@ -0,0 +1,50 @@
+#include <memory>
+#include <gmock/gmock.h>
+
+#include "Nux/Nux.h"
+#include "NuxGraphics/GraphicsDisplay.h"
+#include "NuxGraphics/GpuDevice.h"
+#include "NuxGraphics/IOpenGLFrameBufferObject.h"
+
+using namespace testing;
+
+namespace {
+
+struct TestFrameBufferObject : Test
+{
+  virtual void SetUp()
+  {
+    nux::NuxInitialize(0);
+    wnd_thread.reset(nux::CreateNuxWindow("nux::TestFrameBufferObject", 300, 200, nux::WINDOWSTYLE_NORMAL, NULL, false, NULL, NULL));
+    ASSERT_NE(nux::GetGraphicsDisplay(), nullptr);
+    gpu = nux::GetGraphicsDisplay()->GetGpuDevice();
+    ASSERT_NE(gpu, nullptr);
+  }
+
+  std::unique_ptr<nux::WindowThread> wnd_thread;
+  nux::GpuDevice* gpu;
+};
+
+// FormatFrameBufferObject() used to clear the attachment vectors right after
+// they were sized, so attaching indexed an empty vector and the FBO never
+// released what was attached (LP: #2160298).
+TEST_F(TestFrameBufferObject, ColourAttachmentIsKeptAndReleased)
+{
+  nux::ObjectPtr<nux::IOpenGLBaseTexture> texture =
+    gpu->CreateTexture(64, 64, 1, nux::BITFMT_R8G8B8A8, NUX_TRACKER_LOCATION);
+  ASSERT_TRUE(texture.IsValid());
+  int refs_before = texture->GetReferenceCount();
+
+  {
+    nux::ObjectPtr<nux::IOpenGLFrameBufferObject> fbo = gpu->CreateFrameBufferObject();
+    ASSERT_TRUE(fbo.IsValid());
+    fbo->FormatFrameBufferObject(64, 64, nux::BITFMT_R8G8B8A8);
+    fbo->SetTextureAttachment(0, texture, 0);
+    EXPECT_TRUE(fbo->TextureAttachment(0) == texture);
+    EXPECT_GT(texture->GetReferenceCount(), refs_before);
+  }
+
+  EXPECT_EQ(texture->GetReferenceCount(), refs_before);
+}
+
+}
