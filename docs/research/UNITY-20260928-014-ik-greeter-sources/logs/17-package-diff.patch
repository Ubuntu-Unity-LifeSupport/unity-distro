--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,22 @@
+indicator-keyboard (0.0.0+19.10.20240924-0ubuntu1+unity4) resolute; urgency=medium
+
+  * lib/main.vala: do not rewrite the greeter's input sources while
+    AccountsService has no data. When accounts-daemon restarts, the listed
+    users are loaded with an empty cache for a fraction of a second, and
+    migrate_input_sources() wrote sources=[] and current=list.size - 1
+    (4294967295) over the greeter's layouts; a stored 4294967295 came back
+    after a reboot as the last layout. The pass is now skipped while no
+    counted user has data and redone on ActUserManager::user-changed. Users
+    are listed afresh on every pass, and a manager notify::is-loaded handler
+    is connected when the manager was already loaded at start too (an
+    instance started inside the reload window never migrated again). Write
+    sources before current, and only values that changed.
+  * lib/input-sources.vala: greeter_sources_known() and greeter_current()
+    (0 with no sources, the wanted index if in range, else the last).
+  * tests: add greeter-sources-known and greeter-current.
+
+ -- Ubuntu Unity Life Support <mihail.rozshko@gmail.com>  Tue, 29 Sep 2026 10:16:00 +0000
+
 indicator-keyboard (0.0.0+19.10.20240924-0ubuntu1+unity3) resolute; urgency=medium
 
   * lib/input-sources.vala: read the xkb layouts of a user's InputSources
diff --git a/lib/input-sources.vala b/lib/input-sources.vala
index db75e43..749a731 100644
--- a/lib/input-sources.vala
+++ b/lib/input-sources.vala
@@ -42,3 +42,27 @@ string[] get_xkb_input_sources (Variant? input_sources) {
 
 	return sources;
 }
+
+/*
+ * Whether the greeter's input sources can be rebuilt from AccountsService.
+ * While accounts-daemon restarts, the listed users are loaded but their cache
+ * is empty (no user name, no input sources) for a fraction of a second;
+ * rebuilding then wrote an empty list over the greeter's layouts. Not while
+ * every counted user is in that state (UNITY-20260928-014).
+ */
+bool greeter_sources_known (uint users_with_data, uint users_without_data) {
+	return users_with_data > 0 || users_without_data == 0;
+}
+
+/*
+ * The current index to store for the greeter: the wanted one if it is in
+ * range, else the last, and 0 when there are no sources (list.size - 1
+ * underflowed to 4294967295 there, UNITY-20260928-014).
+ */
+uint greeter_current (uint wanted, uint n_sources) {
+	if (n_sources == 0) {
+		return 0;
+	}
+
+	return wanted < n_sources ? wanted : n_sources - 1;
+}
