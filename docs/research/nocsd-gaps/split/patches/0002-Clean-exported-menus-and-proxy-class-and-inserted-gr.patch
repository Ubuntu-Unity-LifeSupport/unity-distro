+
 void GTKNoCSDMenuPrepare(void) {
 	// Fetch the functions of the global menu once, when it is first needed
 
@@ -4507,6 +4663,536 @@ void GTKNoCSDMenuPrepare(void) {
 	}
 
 	GTKNoCSDMenuReady = true;
