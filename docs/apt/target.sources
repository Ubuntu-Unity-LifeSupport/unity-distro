# The Ubuntu archive as the reference target system (target2, Clean-2) uses
# it - /etc/apt/sources.list.d/ubuntu.sources measured 2026-09-27
# (docs/research/UNITY-20260927-048-version-safety/logs/02). Read by
# scripts/apt_view.py for its isolated apt view; our own repository is not
# listed here (users add it by our install instructions) and is modelled from
# the gated aptly snapshot instead. deb-src lines only measure source versions
# per pocket; -proposed is measured, never used for binaries, as on target2.

Types: deb deb-src
URIs: http://de.archive.ubuntu.com/ubuntu
Suites: resolute resolute-updates resolute-backports
Components: main universe restricted multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb deb-src
URIs: http://security.ubuntu.com/ubuntu/
Suites: resolute-security
Components: main universe restricted multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb-src
URIs: http://de.archive.ubuntu.com/ubuntu
Suites: resolute-proposed
Components: main universe restricted multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
